# Copy to .env (never commit .env). Where each variable is used is in docs/SETUP.md.

# ---- Web (public, shipped to the browser; safe because Row Level Security is on) ----
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # "publishable" key (older dashboards: "anon" key)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   # use the region of your PostHog account

# ---- Ingest (SECRET, only on your machine and in GitHub Actions secrets) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=                 # "secret" key (older dashboards: "service_role" key)
GEMINI_API_KEY=                      # key from a Google AI Studio project dedicated to ingestion
LLM_MODEL=                           # exact Flash/Flash-Lite model name that shows a free tier in AI Studio
LLM_MAX_CALLS_PER_RUN=30
INGEST_WINDOW_HOURS=48
INGEST_MAX_ITEMS_PER_FEED=30
DRY_RUN=false
