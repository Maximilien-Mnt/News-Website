---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Brève" description="Page non trouvée.">
  <article class="page error">
    <h1>404</h1>
    <p class="page__intro">
      La brève que vous cherchez n’a pas été trouvée. Elle a peut-être été
      déplacée, supprimée, ou n’existe pas encore.
    </p>
    <p class="page__foot">
      <a href="/">Retour à l’accueil</a>
    </p>
  </article>
</BaseLayout>
