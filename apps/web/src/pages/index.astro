---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryList from '../components/StoryList';
import { STORIES } from '../lib/mocks/stories';
---

<BaseLayout title="Accueil — Brève">
  <main data-intro class="home-grid">
    <aside class="home-filters" id="filtres">
      <span class="visually-hidden">Colonne des filtres (vide pour l'instant)</span>
    </aside>

    <StoryList stories={STORIES} client:load />

    <aside class="home-aside" id="aside">
      <span class="visually-hidden">Colonne aside (vide pour l'instant)</span>
    </aside>
  </main>
</BaseLayout>
