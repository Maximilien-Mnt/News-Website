---
interface Props {
  title: string;
  children: string;
}

const { title, children } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Brève — actualité mondiale en ultra-court." />
    <title>{title}</title>
  </head>
  <body>
    <main>{children}</main>
  </body>
</html>